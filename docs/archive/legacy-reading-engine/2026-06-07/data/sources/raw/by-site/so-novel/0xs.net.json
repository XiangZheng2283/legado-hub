[
  {
    "url": "https://www.0xs.net/",
    "name": "零点小说",
    "comment": "章节限流严重，即便线程数为1也会被限流，正文内容会被替换为“访问太频繁了，奴家受不了啦，请30秒过后刷新重试！！！”。发布页：https://www.cxysb.com/",
    "ignoreSsl": true,
    "search": {
      "url": "https://www.0xs.net/search.html?kw=%s",
      "method": "get",
      "result": ".result_list > ul > li > .book",
      "bookName": ".name > a",
      "author": ".author",
      "status": ".serial",
      "wordCount": ".count",
      "category": ".type",
      "pagination": true,
      "nextPage": ".page > span > a:nth-child(2), .page > span > a:nth-child(3), .page > span > a:nth-child(4)"
    },
    "book": {
      "url": "https://www.0xs.net/txt_1/(.*?).html"
    },
    "toc": {
      "url": "https://www.0xs.net/la_1/%s.html",
      "item": ".catalog > div > ul > li > a"
    },
    "chapter": {
      "title": ".title > h1@js:r=r.replace(/\\(\\d+\\/\\d+\\)/, '');",
      "content": ".content",
      "paragraphTagClosed": true,
      "filterTxt": "【[^】]+】小说免费阅读，请收藏[^【】]*【[^】]+】|本章未完，点击\\[下一页]继续阅读--|\\(本章完\\)",
      "filterTag": "",
      "pagination": true,
      "nextPage": "#next",
      "nextChapterLink": "https://www\\.0xs\\.net/txt/\\d+/\\d+\\.html"
    },
    "crawl": {
      "concurrency": 1,
      "minInterval": 1000,
      "maxInterval": 3000
    }
  }
]
