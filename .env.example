LEGADOHUB_BROWSER_PROVIDER=chromium
LEGADOHUB_BROWSER_ENABLED=1
LEGADOHUB_BROWSER_DISABLE_SANDBOX=0
# Optional remote mode:
# LEGADOHUB_BROWSER_PROVIDER=browserless
# LEGADOHUB_BROWSERLESS_WS=ws://127.0.0.1:3000/chromium/playwright
# LEGADOHUB_BROWSERLESS_TOKEN=
LEGADOHUB_BROWSER_PUBLIC_BASE_URL=http://127.0.0.1:8765
LEGADOHUB_BROWSER_PROFILE_ROOT=backend/data/browser_profiles
LEGADOHUB_BROWSER_CONNECT_TIMEOUT_MS=5000
LEGADOHUB_BROWSER_ACTION_TIMEOUT_MS=90000

# Local mode defaults. Set LEGADOHUB_BIND_ADDRESS to a LAN address only for a
# controlled LAN test; public deployments use docker-compose.public.yml. The
# admin listener intentionally defaults to all interfaces. Set its exact base
# URL/hosts/origins and secure forwarding before allowing untrusted access.
LEGADOHUB_BIND_ADDRESS=127.0.0.1
LEGADOHUB_PORT=8765
LEGADOHUB_ADMIN_BIND_ADDRESS=0.0.0.0
LEGADOHUB_ADMIN_PORT=8766
LEGADOHUB_APP_UID=1000
LEGADOHUB_APP_GID=1000
LEGADOHUB_OFFICIAL_PLUGINS_DIR=./plugins/sources/official
# Optional: use only with docker-compose.plugins.yml. This writable host directory
# mounts directly at the runtime path and is seeded from the image when empty.
# LEGADOHUB_THIRDPARTY_PLUGINS_DIR=/absolute/path/to/thirdparty
LEGADOHUB_PUBLIC_MODE=0
LEGADOHUB_PUBLIC_BASE_URL=http://127.0.0.1:8765
LEGADOHUB_ALLOWED_HOSTS=127.0.0.1,localhost
LEGADOHUB_ALLOWED_ORIGINS=http://127.0.0.1:8765
LEGADOHUB_TRUSTED_PROXIES=127.0.0.1/32
LEGADOHUB_ADMIN_BASE_URL=http://127.0.0.1:8766
LEGADOHUB_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
LEGADOHUB_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:8766
LEGADOHUB_ADMIN_TRUSTED_PROXIES=127.0.0.1/32

# First startup only. Prefer the Docker secret file in public mode.
# LEGADOHUB_ADMIN_PASSWORD=
# LEGADOHUB_ADMIN_PASSWORD_FILE=/run/secrets/legadohub_admin_password
# LEGADOHUB_PUBLIC_HOST=books.example.com
# LEGADOHUB_ADMIN_PASSWORD_SECRET_FILE=/absolute/restricted/admin_password.txt
# Public release requires a WAF/CDN rate limiter in front of Caddy. Set the
# exact proxy CIDR and acknowledge the gate only after its attack smoke passes.
# LEGADOHUB_EDGE_TRUSTED_PROXIES=192.0.2.10/32
# LEGADOHUB_EDGE_RATE_LIMIT_VERIFIED=1
